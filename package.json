{
  "name": "mds-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format",
    "dev:editor": "pnpm --filter @mds/editor dev",
    "build:editor": "pnpm --filter @mds/editor build",
    "build:theme": "tsx packages/theme-builder/src/cli.ts build",
    "build:theme:default": "pnpm build:theme themes/default",
    "build:theme:folio": "pnpm build:theme themes/folio",
    "build:theme:atelier": "pnpm build:theme themes/atelier",
    "build:theme:clarity": "pnpm build:theme themes/clarity",
    "build:theme:canvas": "pnpm build:theme themes/canvas",
    "test:visual": "tsx scripts/visual-smoke.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
