{
  "name": "@mds-crate/theme-builder",
  "version": "0.1.0-beta.0",
  "description": "Build, watch, inspect, and pack package-defined MDS themes.",
  "keywords": ["mds", "markdown", "theme", "builder"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/mds.git",
    "directory": "packages/theme-builder"
  },
  "homepage": "https://github.com/ziyu/mds#readme",
  "bugs": { "url": "https://github.com/ziyu/mds/issues" },
  "type": "module",
  "files": ["dist"],
  "engines": { "node": ">=20.19.0" },
  "publishConfig": { "access": "public" },
  "bin": {
    "mds-theme": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./cli-runner": {
      "types": "./dist/cli-runner.d.ts",
      "import": "./dist/cli-runner.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/prune-package-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build && node ../../scripts/manage-package-license.mjs add",
    "postpack": "node ../../scripts/manage-package-license.mjs remove"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@mds-crate/blocks": "workspace:*",
    "@mds-crate/theme-loader": "workspace:*",
    "esbuild": "^0.27.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
