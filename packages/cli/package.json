{
  "name": "@mds/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "mds": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mds/parser": "workspace:*",
    "@mds/renderer-html": "workspace:*",
    "@mds/theme-default": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
