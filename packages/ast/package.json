{
  "name": "@mds-crate/ast",
  "version": "0.1.0-beta.0",
  "description": "AST types and contracts for MDS documents.",
  "keywords": ["mds", "markdown", "ast", "markup"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/mds.git",
    "directory": "packages/ast"
  },
  "homepage": "https://github.com/ziyu/mds#readme",
  "bugs": { "url": "https://github.com/ziyu/mds/issues" },
  "type": "module",
  "files": ["dist"],
  "engines": { "node": ">=20.19.0" },
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/prune-package-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
