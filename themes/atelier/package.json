{
  "name": "@mds-crate/theme-atelier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "mdsTheme": {
    "source": "./src/theme.tsx",
    "dist": "./dist/theme",
    "blockPacks": [
      "@mds-crate/blocks/standard"
    ],
    "assets": {
      "css": "./src/style.css",
      "js": "./src/script.js",
      "shell": "./src/shell.html",
      "preview": "./src/preview.svg"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. build:theme themes/atelier"
  },
  "dependencies": {
    "@mds-crate/blocks": "workspace:*"
  },
  "devDependencies": {
    "@mds-crate/theme-builder": "workspace:*"
  }
}
